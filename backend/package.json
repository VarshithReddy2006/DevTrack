{
  "name": "devtrack-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:all": "tsx watch src/index.ts & tsx watch src/worker-entrypoint.ts",
    "worker": "tsx src/worker-entrypoint.ts",
    "worker:sync": "tsx src/worker-entrypoint.ts sync",
    "worker:readiness": "tsx src/worker-entrypoint.ts readiness",
    "worker:xp": "tsx src/worker-entrypoint.ts xp",
    "worker:maintenance": "tsx src/worker-entrypoint.ts maintenance",
    "worker:resume-intelligence": "tsx src/worker-entrypoint.ts resume-intelligence",
    "worker:dataset": "tsx src/worker-entrypoint.ts dataset",
    "build": "tsc -p tsconfig.json && node fix-esm-imports.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "migrate:daily-challenge-tiers": "tsx src/db/migrations/run-daily-challenge-tiers.ts",
    "test:safety": "vitest run -c vitest.safety.config.ts",
    "test:unit": "npm run test:safety && vitest run --exclude src/__tests__/integration/**",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.2",
    "@clerk/express": "^2.1.22",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.76.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "date-fns": "^4.3.0",
    "docx": "^9.7.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "mammoth": "^1.12.0",
    "mongoose": "^8.14.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "openai": "^6.39.0",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.43.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/ioredis": "^4.28.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^4.1.5",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
