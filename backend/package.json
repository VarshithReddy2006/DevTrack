{
  "name": "devtrack-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:all": "tsx watch src/index.ts & tsx watch src/worker-entrypoint.ts",
    "worker": "tsx src/worker-entrypoint.ts",
    "worker:sync": "tsx src/worker-entrypoint.ts sync",
    "worker:readiness": "tsx src/worker-entrypoint.ts readiness",
    "worker:xp": "tsx src/worker-entrypoint.ts xp",
    "worker:maintenance": "tsx src/worker-entrypoint.ts maintenance",
    "worker:resume-intelligence": "tsx src/worker-entrypoint.ts resume-intelligence",
    "worker:dataset": "tsx src/worker-entrypoint.ts dataset",
    "worker:render": "tsx src/worker-entrypoint.ts render",
    "postinstall": "node build-ats-core.mjs && node node_modules/@devtrack/contracts/build-for-app.mjs",
    "prebuild": "node build-ats-core.mjs",
    "build": "tsc -p tsconfig.json && node fix-esm-imports.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "migrate:up": "node dist/db/migrations/cli.js up",
    "migrate:down": "node dist/db/migrations/cli.js down",
    "migrate:status": "node dist/db/migrations/cli.js status",
    "migrate:evidence-ledger": "tsx src/db/migrations/run-evidence-ledger.ts",
    "migrate:public-profile-opt-in": "tsx src/db/migrations/run-public-profile-opt-in.ts",
    "migrate:leagues": "tsx src/db/migrations/run-leagues.ts",
    "migrate:daily-challenge-tiers": "tsx src/db/migrations/run-daily-challenge-tiers.ts",
    "test:safety": "vitest run -c vitest.safety.config.ts",
    "test:unit": "npm run test:safety && vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:chaos": "vitest run -c vitest.chaos.config.ts",
    "test:e2e:server": "tsx tests/e2e-resume-server.ts"
  },
  "dependencies": {
    "@devtrack/contracts": "file:../packages/contracts",
    "@clerk/backend": "^3.8.2",
    "@clerk/express": "^2.1.22",
    "@devtrack/ats-core": "file:../packages/ats-core",
    "@google/generative-ai": "^0.24.1",
    "@resvg/resvg-js": "^2.6.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-mongoose": "^0.71.0",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.76.7",
    "bullmq-otel": "^1.3.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "date-fns": "^4.3.0",
    "docx": "^9.7.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "mammoth": "^1.12.0",
    "mongoose": "^8.14.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "openai": "^6.39.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "puppeteer": "^24.43.1",
    "satori": "^0.63.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/ioredis": "^4.28.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^4.1.5",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
