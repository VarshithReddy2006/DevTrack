# DevTrack Backend Environment Variables
# Copy to .env and fill in values for your environment

# Server
PORT=3001
NODE_ENV=production

# Database
MONGODB_URI=mongodb://localhost:27017/devtrack
# Log queries that take SLOW_QUERY_THRESHOLD_MS or longer, with their winning plan (IXSCAN / COLLSCAN).
# Defaults to on outside production and off in production; set to true to use it in staging.
# SLOW_QUERY_PROFILING=true
SLOW_QUERY_THRESHOLD_MS=100



# Platform API Keys (optional - for sync features)
GITHUB_TOKEN=
LEETCODE_SESSION=

# CORS - REQUIRED: Use production frontend URL in production
# Must use HTTPS in production (will throw error otherwise)
CORS_ORIGIN=http://localhost:5173
# Public origin of this API. Used for the absolute og:image link on /u/:username share pages.
# Leave unset in production to keep the static preview image.
PUBLIC_API_URL=http://localhost:3001

# Reverse proxy hops in front of the API (leave unset when exposed directly).
# 1 for Render and for the nginx container in docker-compose.prod.yml. This makes
# req.ip the real client address so the IP-keyed rate limiters count each client
# separately. Do NOT set it when the API is reachable without a proxy: clients
# could then spoof X-Forwarded-For and dodge the limits.
# TRUST_PROXY=1

# Signed download links for generated PDFs (dossier). Required in production, 16+ characters.
# The API and the render worker must use the same value.
OBJECT_STORAGE_SIGNING_SECRET=
DOSSIER_SIGNING_SECRET=

# HMAC key for the daily ProfileAuditLog checkpoints (tamper-evident audit chain).
# Required in production on the maintenance worker. Changing it makes older checkpoints fail verification.
AUDIT_CHECKPOINT_SECRET=

# Rate Limiting (general endpoints)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth Rate Limiting (stricter limits for auth endpoints)
# Prevent brute-force attacks on login/register
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_MAX_REQUESTS_WINDOW_1H=20

# Clerk Auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Optional Clerk PEM public key for networkless stateless score-preview authentication.
# Copy the PEM public key from your Clerk instance; never use a private key here.
CLERK_JWT_KEY=

# Web Push contest alerts (optional). Configure on the API and maintenance worker.
# Generate once with: npx web-push generate-vapid-keys --json
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# During rotation, retain the old pair until existing browsers resubscribe.
VAPID_PREVIOUS_PUBLIC_KEY=
VAPID_PREVIOUS_PRIVATE_KEY=
