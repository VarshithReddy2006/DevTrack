{
  "name": "@devtrack/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "build-for-app.mjs",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:openapi": "tsx src/openapi/build.ts",
    "check:openapi": "tsx src/openapi/build.ts --check",
    "typecheck:openapi": "tsc -p tsconfig.openapi.json",
    "test": "npm run build && npm run typecheck:openapi && node --import tsx --test test/*.test.mjs"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hyperjump/json-schema": "1.18.1",
    "@types/node": "22.15.3",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "zod-to-json-schema": "3.25.2"
  }
}
